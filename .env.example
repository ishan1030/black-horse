# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (laptop-hosted primary database)
DATABASE_URL="postgresql://blackhorse:blackhorse@localhost:5432/blackhorse?schema=public"

# API
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Seed admin (used by prisma db seed)
SEED_ADMIN_EMAIL=owner@blackhorse.shoes
SEED_ADMIN_PASSWORD=change-me

# Fonepay (leave empty until you have merchant credentials — COD works
# regardless, and Fonepay orders can be marked paid manually in the ERP)
FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET_KEY=
FONEPAY_BASE_URL=https://dev-clientapi.fonepay.com/api
PUBLIC_WEB_URL=https://bhandariventures.com

# Telegram bot (apps/bot) — create a bot with @BotFather to get the token.
# The bot logs into the API with its own admin account and only answers
# whitelisted chat ids (comma-separated; leave empty to allow all while testing).
TELEGRAM_BOT_TOKEN=
BOT_ADMIN_EMAIL=owner@blackhorse.shoes
BOT_ADMIN_PASSWORD=
ALLOWED_CHAT_IDS=
API_URL=http://localhost:4000/api
